{{#partial "titulo"}}Creá tu cuenta · DonaTrack{{/partial}}
{{#partial "main-clase"}}registro-pagina{{/partial}}

{{#partial "contenido"}}
{{!-- Una sola vista de registro para los dos roles: el rol se elige con el selector de abajo --}}
<section class="registro">
    <div class="hero-brillo" aria-hidden="true"></div>
    <div class="container position-relative">
        <div class="encabezado">
            <span class="chip mb-3">✦ Sumate</span>
            <h1 class="registro-titulo" id="registro-titulo">Creá tu <span class="degrade">cuenta</span></h1>
            <p>Elegí con qué rol te registrás y completá tus datos. Es gratis y no te compromete a donar.</p>
        </div>

        <div class="row g-4 g-lg-5 justify-content-center align-items-start">
            {{!-- El formulario va primero en el HTML: en el celular aparece apenas se entra --}}
            <div class="col-lg-7">
                <form class="tarjeta registro-form" method="post" action="/registro" aria-labelledby="registro-titulo">
                    <p class="form-text">Los campos con <span class="campo-obligatorio" aria-hidden="true">*</span> son obligatorios.</p>
                    {{#if error}}<div class="alert alert-danger" role="alert">{{error}}</div>{{/if}}
                    <fieldset class="registro-rol">
                        <legend class="registro-leyenda">Me registro como</legend>
                        <div class="row g-2">
                            <div class="col-sm-6">
                                <input class="btn-check" type="radio" name="rol" id="rol-donante"
                                       value="donante" autocomplete="off" checked>
                                <label class="opcion-rol" for="rol-donante">
                                    <span class="icono" aria-hidden="true">🎁</span>
                                    <span class="opcion-rol-nombre">Donante</span>
                                    <span class="opcion-rol-texto">Dono bienes y quiero ver a dónde llegan.</span>
                                </label>
                            </div>
                            <div class="col-sm-6">
                                <input class="btn-check" type="radio" name="rol" id="rol-entidad"
                                       value="entidad" autocomplete="off">
                                <label class="opcion-rol" for="rol-entidad">
                                    <span class="icono" aria-hidden="true">🏥</span>
                                    <span class="opcion-rol-nombre">Entidad beneficiaria</span>
                                    <span class="opcion-rol-texto">Necesito donaciones para las personas que atiendo.</span>
                                </label>
                            </div>
                        </div>
                    </fieldset>

                    <fieldset class="registro-grupo">
                        <legend class="registro-leyenda">Datos de la cuenta</legend>
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label" for="correo">Correo electrónico <span class="campo-obligatorio" aria-hidden="true">*</span></label>
                                <input class="form-control" type="email" id="correo" name="correo"
                                       autocomplete="email" placeholder="nombre@ejemplo.com" required>
                                <div class="form-text">Este correo es obligatorio para iniciar sesión, aunque elijas otro medio para recibir avisos.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="contrasena">Contraseña <span class="campo-obligatorio" aria-hidden="true">*</span></label>
                                <input class="form-control" type="password" id="contrasena" name="contrasena"
                                       autocomplete="new-password" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="contrasena-repetida">Repetir contraseña <span class="campo-obligatorio" aria-hidden="true">*</span></label>
                                <input class="form-control" type="password" id="contrasena-repetida"
                                       name="contrasenaRepetida" autocomplete="new-password" required>
                            </div>
                        </div>
                    </fieldset>

                    <div class="panel-rol" data-rol="donante">
                        <fieldset class="registro-grupo">
                            <legend class="registro-leyenda">Tipo de donante <span class="campo-obligatorio" aria-hidden="true">*</span></legend>
                            <div class="btn-group w-100" role="group" aria-label="Tipo de donante">
                                <input class="btn-check" type="radio" name="donanteTipoPersona" id="persona-humana" value="HUMANA" checked required>
                                <label class="btn btn-outline-primary" for="persona-humana">Persona humana</label>
                                <input class="btn-check" type="radio" name="donanteTipoPersona" id="persona-juridica" value="JURIDICA" required>
                                <label class="btn btn-outline-primary" for="persona-juridica">Persona jurídica</label>
                            </div>
                        </fieldset>
                        <fieldset class="registro-grupo" data-persona="HUMANA">
                            <legend class="registro-leyenda">Tus datos personales</legend>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="donante-nombre">Nombre <span class="campo-obligatorio" aria-hidden="true">*</span></label>
                                    <input class="form-control" type="text" id="donante-nombre"
                                           name="donanteNombre" autocomplete="given-name" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="donante-apellido">Apellido <span class="campo-obligatorio" aria-hidden="true">*</span></label>
                                    <input class="form-control" type="text" id="donante-apellido"
                                           name="donanteApellido" autocomplete="family-name" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="donante-edad">Edad <span class="campo-obligatorio" aria-hidden="true">*</span></label>
                                    <input class="form-control" type="number" id="donante-edad" name="donanteEdad" min="0" max="130" step="1" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="donante-tipo-documento">Tipo de documento <span class="campo-obligatorio" aria-hidden="true">*</span></label>
                                    <select class="form-select" id="donante-tipo-documento" name="donanteTipoDocumento" required>
                                        <option value="">Elegí una opción</option>
                                        <option value="DNI">DNI</option>
                                        <option value="CUIT">CUIT</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="donante-numero-documento">Número de documento <span class="campo-obligatorio" aria-hidden="true">*</span></label>
                                    <input class="form-control" type="text" id="donante-numero-documento"
                                           name="donanteNumeroDocumento" inputmode="numeric" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="donante-genero">Género <span class="campo-obligatorio" aria-hidden="true">*</span></label>
                                    <select class="form-select" id="donante-genero" name="donanteGenero" required>
                                        <option value="">Elegí una opción</option>
                                        <option value="FEMENINO">Femenino</option>
                                        <option value="MASCULINO">Masculino</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="donante-direccion">Dirección <span class="campo-obligatorio" aria-hidden="true">*</span></label>
                                    <input class="form-control" type="text" id="donante-direccion"
                                           name="donanteDireccion" autocomplete="street-address"
                                           placeholder="Calle, número, localidad" required>
                                </div>
                            </div>
                        </fieldset>
                        <fieldset class="registro-grupo" data-persona="JURIDICA" hidden disabled>
                            <legend class="registro-leyenda">Datos de la persona jurídica</legend>
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label" for="donante-razon-social">Razón social <span class="campo-obligatorio" aria-hidden="true">*</span></label>
                                    <input class="form-control" id="donante-razon-social" name="donanteRazonSocial" autocomplete="organization" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="donante-cuit">CUIT <span class="campo-obligatorio" aria-hidden="true">*</span></label>
                                    <input class="form-control" id="donante-cuit" name="donanteCuit" inputmode="numeric" pattern="[0-9]{2}-?[0-9]{8}-?[0-9]" placeholder="30-12345678-9" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="donante-tipo-organizacion">Tipo de organización <span class="campo-obligatorio" aria-hidden="true">*</span></label>
                                    <select class="form-select" id="donante-tipo-organizacion" name="donanteTipoOrganizacion" required>
                                        <option value="">Elegí una opción</option>
                                        <option value="GUBERNAMENTAL">Gubernamental</option>
                                        <option value="ONG">ONG</option>
                                        <option value="EMPRESA">Empresa</option>
                                        <option value="INSTITUCION">Institución</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="donante-rubro">Rubro <span class="campo-obligatorio" aria-hidden="true">*</span></label>
                                    <input class="form-control" id="donante-rubro" name="donanteRubro" required>
                                </div>
                            </div>
                        </fieldset>
                        <fieldset class="registro-grupo">
                            <legend class="registro-leyenda">Contacto y notificaciones</legend>
                            <p class="form-text">Tu correo electrónico ya cuenta como medio de contacto. El teléfono debe incluir + y código de país, sin espacios (formato E.164).</p>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="donante-telefono">Teléfono (opcional)</label>
                                    <input class="form-control" type="tel" id="donante-telefono" name="donanteTelefono" autocomplete="tel" pattern="\+[1-9][0-9]{1,14}" placeholder="Ej.: +5491155555555">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="donante-medio-contacto">Medio de contacto predeterminado <span class="campo-obligatorio" aria-hidden="true">*</span></label>
                                    <select class="form-select" id="donante-medio-contacto" name="donanteMedioContacto" required>
                                        <option value="CORREO" selected>Correo electrónico</option>
                                        <option value="SMS" disabled>SMS</option>
                                        <option value="WHATSAPP" disabled>WhatsApp</option>
                                    </select>
                                    <div class="form-text">Recibirás la bienvenida y las notificaciones por este medio. Para elegir SMS o WhatsApp, agregá un teléfono.</div>
                                </div>
                            </div>
                        </fieldset>
                    </div>

                    <div class="panel-rol" data-rol="entidad">
                        <fieldset class="registro-grupo">
                            <legend class="registro-leyenda">Datos de la entidad</legend>
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label" for="entidad-razon-social">Razón social <span class="campo-obligatorio" aria-hidden="true">*</span></label>
                                    <input class="form-control" type="text" id="entidad-razon-social"
                                           name="entidadRazonSocial" autocomplete="organization"
                                           placeholder="Nombre de la entidad" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="entidad-direccion">Dirección <span class="campo-obligatorio" aria-hidden="true">*</span></label>
                                    <input class="form-control" type="text" id="entidad-direccion"
                                           name="entidadDireccion" autocomplete="street-address"
                                           placeholder="Calle, número, localidad" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="entidad-telefono">Teléfono <span class="campo-obligatorio" aria-hidden="true">*</span></label>
                                    <input class="form-control" type="tel" id="entidad-telefono"
                                           name="entidadTelefono" autocomplete="tel" placeholder="11 5555 5555" required>
                                </div>
                                <div class="col-12">
                                    <p class="dato small mb-0">
                                        Después de crear la cuenta vas a poder cargar las necesidades de tu entidad
                                        y confirmar la recepción de cada donación.
                                    </p>
                                </div>
                            </div>
                        </fieldset>
                    </div>

                    <div class="form-check mt-4">
                        <input class="form-check-input" type="checkbox" id="terminos" name="terminos"
                               value="acepto" required>
                        <label class="form-check-label" for="terminos">
                            Acepto los <a href="/legal">términos y la política de privacidad</a>. <span class="campo-obligatorio" aria-hidden="true">*</span>
                        </label>
                    </div>

                    <div class="d-grid mt-4">
                        <button class="btn btn-primary btn-lg rounded-pill" type="submit">Crear mi cuenta</button>
                    </div>
                </form>
            </div>

            <div class="col-lg-5">
                <aside class="tarjeta">
                    <h2 class="registro-lateral-titulo">Qué podés hacer con tu cuenta</h2>
                    <ul class="lista-check registro-beneficios">
                        <li>Historial completo de cada donación</li>
                        <li>Avisos por mail, SMS o WhatsApp</li>
                        <li>Seguimiento de los traslados en el mapa</li>
                        <li>Datos personales protegidos</li>
                    </ul>
                    <hr class="my-4">
                    <p class="mb-3">¿Ya tenés una cuenta?</p>
                    <a class="btn btn-outline-primary rounded-pill w-100" href="/login">Iniciá sesión</a>
                </aside>
            </div>
        </div>
    </div>
</section>
{{/partial}}

{{#partial "scripts"}}<script src="/registro.js" defer></script>{{/partial}}

{{> layout}}
