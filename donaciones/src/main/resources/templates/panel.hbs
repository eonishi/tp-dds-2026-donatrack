{{#partial "titulo"}}{{titulo}} · DonaTrack{{/partial}}

{{#partial "contenido"}}
<section class="container py-5 panel-app" data-seccion="{{seccion}}">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <span class="chip mb-2">Panel operativo</span>
            <h1 class="mb-1">{{titulo}}</h1>
            <p class="text-body-secondary mb-0">Sesión: {{usuario.email}}</p>
        </div>
        <a class="btn btn-outline-primary rounded-pill" href="/dashboard">Volver al panel</a>
    </div>

    <div id="panel-alert" class="alert d-none" role="alert"></div>

    <div id="vista-donaciones" class="panel-vista">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 mb-0">Donaciones</h2>
            <button class="btn btn-primary rounded-pill" data-action="mostrar-form-donacion">Nueva donación</button>
        </div>
        <form id="form-donacion" class="tarjeta p-4 mb-4 d-none">
            <h3 class="h5">Cargar donación</h3>
            <div class="row g-3">
                <div class="col-md-5"><label class="form-label">ID del donante</label><input class="form-control" name="donanteId" required placeholder="UUID del donante"></div>
                <div class="col-md-7"><label class="form-label">Descripción del bien</label><input class="form-control" name="descripcion" required></div>
                <div class="col-md-3"><label class="form-label">Cantidad</label><input class="form-control" type="number" step="0.01" min="0.01" name="cantidad" required></div>
                <div class="col-md-3"><label class="form-label">Unidad</label><select class="form-select" name="unidad"><option>UNIDADES</option><option>KILOGRAMOS</option><option>LITROS</option></select></div>
                <div class="col-md-3"><label class="form-label">Categoría</label><select class="form-select" name="categoria"><option>ALIMENTO</option><option>VESTIMENTA</option><option>MOBILIARIO</option></select></div>
                <div class="col-md-3"><label class="form-label">Subcategoría</label><input class="form-control" name="subcategoria" required></div>
            </div>
            <div class="mt-3 d-flex gap-2"><button class="btn btn-primary" type="submit">Guardar</button><button class="btn btn-link" type="button" data-action="ocultar-form-donacion">Cancelar</button></div>
        </form>
        <div id="donaciones-lista" class="row g-3"><p class="text-body-secondary">Cargando donaciones…</p></div>
    </div>

    <div id="vista-necesidades" class="panel-vista d-none">
        <div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h4 mb-0">Necesidades de una entidad</h2></div>
        <form id="form-necesidad" class="tarjeta p-4 mb-4">
            <div class="row g-3">
                <div class="col-md-3"><label class="form-label">ID de entidad</label><input class="form-control" name="entidadId" required></div>
                <div class="col-md-3"><label class="form-label">Tipo</label><select class="form-select" name="tipo"><option>EXTRAORDINARIA</option><option>RECURRENTE</option></select></div>
                <div class="col-md-3"><label class="form-label">Categoría</label><select class="form-select" name="categoria"><option>ALIMENTO</option><option>VESTIMENTA</option><option>MOBILIARIO</option></select></div>
                <div class="col-md-3"><label class="form-label">Subcategoría</label><input class="form-control" name="subcategoria" required></div>
                <div class="col-md-3"><label class="form-label">Cantidad objetivo</label><input class="form-control" type="number" step="0.01" name="cantidadObjetivo" required></div>
                <div class="col-md-3"><label class="form-label">Unidad</label><select class="form-select" name="unidad"><option>UNIDADES</option><option>KILOGRAMOS</option><option>LITROS</option></select></div>
                <div class="col-md-6"><label class="form-label">Descripción</label><input class="form-control" name="descripcion" required></div>
            </div>
            <button class="btn btn-primary mt-3" type="submit">Agregar necesidad</button>
        </form>
        <div id="necesidades-lista" class="row g-3"><p class="text-body-secondary">Ingresá un ID para consultar necesidades.</p></div>
    </div>

    <div id="vista-logistica" class="panel-vista d-none">
        <div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h4 mb-0">Operación logística</h2><button class="btn btn-outline-primary rounded-pill" data-action="recargar-logistica">Actualizar</button></div>
        <div class="row g-4">
            <div class="col-lg-5"><div class="tarjeta p-4"><h3 class="h5">Camiones</h3><form id="form-camion" class="row g-2 mb-3"><input class="form-control" name="patente" placeholder="Patente" required><input class="form-control" type="number" step="0.01" name="volumenM3" placeholder="Volumen m³" required><input class="form-control" type="number" step="0.01" name="alturaM" placeholder="Altura m" required><input class="form-control" type="number" step="0.01" name="capacidadCargaKg" placeholder="Capacidad kg" required><button class="btn btn-primary" type="submit">Agregar camión</button></form><div id="camiones-lista"></div></div></div>
            <div class="col-lg-7"><div class="tarjeta p-4"><h3 class="h5">Rutas</h3><div id="rutas-lista"><p class="text-body-secondary">Cargando rutas…</p></div></div></div>
        </div>
    </div>

    <div id="vista-matchmaking" class="panel-vista d-none">
        <div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h4 mb-0">Propuestas de asignación</h2><button class="btn btn-outline-primary rounded-pill" data-action="recargar-matchmaking">Actualizar</button></div>
        <form id="form-matchmaking" class="tarjeta p-4 mb-4"><label class="form-label">ID de donación</label><div class="input-group"><input class="form-control" name="donacionId" required><button class="btn btn-primary" type="submit">Ejecutar matchmaking</button></div></form>
        <div id="matchmaking-lista" class="row g-3"><p class="text-body-secondary">Cargando propuestas…</p></div>
    </div>

    <div id="vista-catalogo" class="panel-vista d-none">
        <div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h4 mb-0">Subcategorías</h2></div>
        <form id="form-subcategoria" class="tarjeta p-4 mb-4"><div class="row g-2"><div class="col-md-6"><input class="form-control" name="nombre" placeholder="Nombre" required></div><div class="col-md-4"><select class="form-select" name="categoria"><option>ALIMENTO</option><option>VESTIMENTA</option><option>MOBILIARIO</option></select></div><div class="col-md-2"><button class="btn btn-primary w-100" type="submit">Agregar</button></div></div></form>
        <div id="catalogo-lista" class="row g-3"><p class="text-body-secondary">Cargando catálogo…</p></div>
    </div>
</section>
<script src="/panel.js"></script>
{{/partial}}

{{> layout}}
