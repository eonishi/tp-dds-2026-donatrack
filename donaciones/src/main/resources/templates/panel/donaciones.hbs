<div id="vista-donaciones" class="panel-vista">
    <div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h4 mb-0">Donaciones</h2><button class="btn btn-primary rounded-pill" data-action="mostrar-form-donacion">Nueva donación</button></div>
    <form id="form-donacion" class="tarjeta p-4 mb-4 d-none">
        <h3 class="h5">Cargar donación</h3>
        <div class="row g-3">
            <div class="col-md-5"><label class="form-label" for="select-donante">Donante</label><select class="form-select" id="select-donante" name="donanteId" required><option value="">Cargando donantes…</option></select></div>
            <div class="col-md-7"><label class="form-label">Descripción del bien</label><input class="form-control" name="descripcion" required></div>
            <div class="col-md-3"><label class="form-label">Cantidad</label><input class="form-control" type="number" step="0.01" min="0.01" name="cantidad" required></div>
            <div class="col-md-3"><label class="form-label">Unidad</label><select class="form-select" name="unidad"><option>UNIDADES</option><option>KILOGRAMOS</option><option>LITROS</option></select></div>
            <div class="col-md-3"><label class="form-label">Categoría</label><select class="form-select" name="categoria"><option>ALIMENTO</option><option>VESTIMENTA</option><option>MOBILIARIO</option></select></div>
            <div class="col-md-3"><label class="form-label">Subcategoría</label><input class="form-control" name="subcategoria" required></div>
        </div>
        <div class="mt-3 d-flex gap-2"><button class="btn btn-primary" type="submit">Guardar</button><button class="btn btn-link" type="button" data-action="ocultar-form-donacion">Cancelar</button></div>
    </form>
    <div id="donaciones-lista" class="row g-3"><p class="text-body-secondary">Cargando donaciones…</p></div>
</div>
