%% ============================================================================
%% ENTREGA 2 — Requerimiento 1
%% "El sistema debe garantizar la trazabilidad de los estados de las donaciones,
%%  desde su recepción hasta su entrega."
%% (Mismo fragmento que el Requerimiento 4 de la Entrega 1, listado de nuevo.)
%% Fragmento mínimo del dominio involucrado.
%% ============================================================================
classDiagram
    direction TB

    class Donacion {
        -estado: EstadoDonacion
        -historialEstado: List~HistorialEstado~
        +asignar()
        +planificarRuta()
        +iniciarTraslado()
        +confirmarEntrega()
        +reportarFalla(justificacion: String)
        +marcarVencida()
        +retornarAlDeposito()
    }
    class HistorialEstado {
        -fecha: LocalDate
        -estadoAlcanzado: NombreEstado
        -justificacion: String
    }
    class EstadoDonacion {
        <<abstract>>
        +getNombreEstado() NombreEstado
        +asignar(donacion: Donacion)
        +planificarRuta(donacion: Donacion)
        +iniciarTraslado(donacion: Donacion)
        +confirmarEntrega(donacion: Donacion)
        +reportarFalla(donacion: Donacion, justificacion: String)
        +marcarVencida(donacion: Donacion)
        +retornarAlDeposito(donacion: Donacion)
    }
    class EnDeposito
    class AsignacionRealizada
    class ListaParaEntregar
    class EnTraslado
    class Entregada
    class EntregaFallida
    class Vencida
    class NombreEstado {
        <<enumeration>>
        EN_DEPOSITO
        ASIGNACION_REALIZADA
        LISTA_PARA_ENTREGAR
        EN_TRASLADO
        ENTREGADA
        ENTREGA_FALLIDA
        VENCIDA
    }

    Donacion *-- EstadoDonacion : estado actual
    Donacion *-- "*" HistorialEstado : historial
    HistorialEstado --> NombreEstado : estadoAlcanzado
    EstadoDonacion <|-- EnDeposito
    EstadoDonacion <|-- AsignacionRealizada
    EstadoDonacion <|-- ListaParaEntregar
    EstadoDonacion <|-- EnTraslado
    EstadoDonacion <|-- Entregada
    EstadoDonacion <|-- EntregaFallida
    EstadoDonacion <|-- Vencida
    EstadoDonacion ..> Donacion : transiciona
