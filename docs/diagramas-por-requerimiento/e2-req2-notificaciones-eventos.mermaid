%% ============================================================================
%% ENTREGA 2 — Requerimiento 2
%% "El sistema debe garantizar el envío de notificaciones por distintos medios
%%  ante: inactividad de una persona donante, asignación de donaciones a la
%%  entidad beneficiaria, inicio de rutas de las entregas y estado de las
%%  entregas."
%% Patrón Template Method (EventoNotificable.generarNotificaciones) + payloads.
%% Fragmento mínimo del dominio involucrado.
%% ============================================================================
classDiagram
    direction TB

    class EventoNotificable {
        <<abstract>>
        +generarNotificaciones() List~Notificacion~
    }
    class EventoBienvenida
    class EventoAsignacion
    class EventoInicioRuta
    class EventoEntregaExitosa
    class EventoEntregaNoSatisfactoria
    class EventoAusenciaDonante
    class Notificacion {
        -destinatario: Notificable
        -mensaje: String
        -payload: NotificacionPayload
        -fechaCreacion: LocalDateTime
        -envios: List~Envio~
        +enviarCon(canales: NotificadorPorCanal) List~Envio~
    }
    class Envio {
        <<record>>
        canal: Canal
        resultado: ResultadoEnvio
    }
    class NotificacionPayload {
        <<interface>>
    }
    class ComprobanteEntrega
    class InfoMapa
    class SinPayload
    class Canal {
        <<enumeration>>
        CORREO
        SMS
        WHATSAPP
    }
    class Notificable {
        <<interface>>
        +notificar(mensaje: String, canales: NotificadorPorCanal) List~Envio~
    }
    class NotificadorPorCanal {
        +enviarPorCorreo(direccion: String, mensaje: String) Envio
        +enviarPorSms(numero: String, mensaje: String) Envio
        +enviarPorWhatsapp(numero: String, mensaje: String) Envio
    }
    class Donante
    class EntidadBeneficiaria
    class MedioDeContacto {
        <<abstract>>
        -contacto: String
        +enviar(mensaje: String, canales: NotificadorPorCanal) Envio
    }
    class CorreoElectronico
    class Whatsapp
    class Sms

    EventoNotificable <|-- EventoBienvenida
    EventoNotificable <|-- EventoAsignacion
    EventoNotificable <|-- EventoInicioRuta
    EventoNotificable <|-- EventoEntregaExitosa
    EventoNotificable <|-- EventoEntregaNoSatisfactoria
    EventoNotificable <|-- EventoAusenciaDonante
    EventoNotificable ..> Notificacion : genera
    Notificacion --> Notificable : destinatario
    Notificacion o-- NotificacionPayload : payload
    Notificacion *-- "*" Envio : envios
    Envio --> Canal : canal
    NotificacionPayload <|.. ComprobanteEntrega
    NotificacionPayload <|.. InfoMapa
    NotificacionPayload <|.. SinPayload
    Donante ..|> Notificable
    EntidadBeneficiaria ..|> Notificable
    MedioDeContacto <|-- CorreoElectronico
    MedioDeContacto <|-- Whatsapp
    MedioDeContacto <|-- Sms
    Donante ..> MedioDeContacto : notifica por el predeterminado
    EntidadBeneficiaria ..> MedioDeContacto : notifica a todos sus correos
    MedioDeContacto ..> NotificadorPorCanal : enviar
    EventoInicioRuta ..> InfoMapa : enlace al mapa
    EventoEntregaExitosa ..> ComprobanteEntrega : comprobante
    EventoAusenciaDonante --> Donante : donante inactivo >20 días
    EventoEntregaNoSatisfactoria --> EntidadBeneficiaria : entrega fallida
