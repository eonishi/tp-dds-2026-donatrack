# Copiá este archivo a .env (está en el .gitignore) y completalo. Lo leen los dos servicios del compose.

# --- Supabase ---
# Project Settings > Database > Connection string > "Session pooler" (puerto 5432).
# Usá el pooler y no la conexión directa (db.<ref>.supabase.co solo tiene IPv6 y Docker suele no tenerlo).
# No uses el "Transaction pooler" (6543): Hibernate usa prepared statements y ese modo no los soporta.
DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.REFERENCIA_DEL_PROYECTO
DB_PASSWORD=

# Debe ser el mismo valor en donaciones y logística para validar las sesiones JWT.
DONATRACK_JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
# Clave exclusiva para llamadas internas entre microservicios.
DONATRACK_API_KEY=cambiar-por-otra-clave-interna
DONATRACK_WEB_ORIGIN=http://localhost:7070
# En el despliegue con HTTPS la cookie de sesión se marca Secure para que no viaje en texto plano.
DONATRACK_COOKIE_SECURE=true

# --- Postgres local (docker compose --profile local up) ---
# DB_URL=jdbc:postgresql://postgres:5432/postgres
# DB_USER=postgres
# DB_PASSWORD=postgres

# --- Opcionales: notificaciones reales (ver README) ---
# RESEND_API_KEY=
# RESEND_FROM=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=
# TWILIO_WHATSAPP_FROM=

# --- Opcionales: fotos de recepción en Supabase Storage (ver README) ---
# Sin estas variables las fotos se guardan en FOTOS_DIR (o un directorio temporal): solo para desarrollo.
# SUPABASE_URL=https://<proyecto>.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=recepciones
# FOTOS_DIR=
