# Copiá este archivo a .env (está en el .gitignore) y completalo. Lo leen los dos servicios del compose.

# --- Supabase ---
# Project Settings > Database > Connection string > "Session pooler" (puerto 5432).
# Usá el pooler y no la conexión directa (db.<ref>.supabase.co solo tiene IPv6 y Docker suele no tenerlo).
# No uses el "Transaction pooler" (6543): Hibernate usa prepared statements y ese modo no los soporta.
# DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USER=postgres.REFERENCIA_DEL_PROYECTO
# DB_PASSWORD=

# --- Postgres local (docker compose --profile local up) ---
DB_URL=jdbc:postgresql://postgres:5432/postgres
DB_USER=postgres
DB_PASSWORD=postgres

# --- Opcionales: notificaciones reales (ver README) ---
# RESEND_API_KEY=
# RESEND_FROM=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=
# TWILIO_WHATSAPP_FROM=
